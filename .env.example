# ─────────────────────────────────────────────────────────────────────────────
# Rivayat — copy to `.env` and fill in. Never commit `.env`.
# Every value here is also settable per-project in the UI; this file is only
# the machine-wide default.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
RV_LOG_LEVEL=debug

# ── Workspace (runtime data lives outside the repo tree in the CAS) ──────────
RV_WORKSPACE_DIR=./workspace
RV_ASSET_STORE_DIR=./workspace/assets
RV_DB_URL=file:./workspace/rivayat.db

# ── API / Web ────────────────────────────────────────────────────────────────
RV_API_PORT=3000
RV_API_PREFIX=api
RV_WEB_ORIGIN=http://localhost:5173

# ── Queue ────────────────────────────────────────────────────────────────────
# Leave REDIS_URL empty to run the pipeline in-process (no Redis needed for dev).
REDIS_URL=
RV_QUEUE_CONCURRENCY=4

# ── LLM: Ollama (local, free, default) ───────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
RV_OLLAMA_TEXT_MODEL=qwen3.5:latest
RV_OLLAMA_FAST_MODEL=qwen3:1.7b
RV_OLLAMA_VISION_MODEL=gemma4:26b
RV_OLLAMA_EMBED_MODEL=nomic-embed-text

# ── LLM/Image: Google Gemini (free text tier; images are paid) ───────────────
GEMINI_API_KEY=
RV_GEMINI_TEXT_MODEL=gemini-3-flash
RV_GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
RV_GEMINI_VISION_MODEL=gemini-3-flash

# ── LLM/Image: OpenRouter (one key, many models) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Rivayat
RV_OPENROUTER_TEXT_MODEL=z-ai/glm-5.2:free
RV_OPENROUTER_IMAGE_MODEL=openai/gpt-5-image-mini
RV_OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# ── Image: local ComfyUI (free draft lane) ───────────────────────────────────
# Port 8188 falls inside a Windows reserved TCP range (8163-8262, WinNAT) on this machine.
COMFYUI_HOST=http://127.0.0.1:8288
RV_COMFYUI_WORKFLOW_DIR=./tools/comfy-workflows
RV_COMFYUI_ENABLED=true

# ── Cost guard: the pipeline aborts before exceeding these ───────────────────
RV_BUDGET_USD_PER_RUN=5.00
RV_BUDGET_USD_PER_DAY=25.00
RV_CONFIRM_SPEND_ABOVE_USD=1.00

# ── Render ───────────────────────────────────────────────────────────────────
RV_FFMPEG_PATH=ffmpeg
RV_FFPROBE_PATH=ffprobe
RV_RENDER_BACKEND=auto
RV_RENDER_CONCURRENCY=2

# ── Hugging Face (model weight downloads for matting / local inference) ──────
HF_TOKEN=
HF_HOME=./workspace/cache/huggingface

# ── Image: remote ComfyUI on Google Colab (free lane, bigger models) ──────────────
# COMFYUI_HOST accepts a remote tunnel URL as well as a local one. The two lanes differ
# only in this value; the adapter speaks the same ComfyUI HTTP API to both.
#
#   local  (SD 1.5 @ 768², 6 GB Quadro RTX 3000)
#     COMFYUI_HOST=http://127.0.0.1:8288
#     RV_COMFYUI_REMOTE=false
#     COMFYUI_AUTH_TOKEN=            # not needed: loopback only
#
#   remote (SDXL / FLUX-schnell @ 1024², ~15 GB Colab T4)
#     COMFYUI_HOST=https://<random-words>.trycloudflare.com
#     RV_COMFYUI_REMOTE=true
#     COMFYUI_AUTH_TOKEN=<the 43-char secret the notebook prints>
#
# tools/colab/rivayat-comfyui.ipynb prints all three lines ready to paste. Run it on
# Colab Pro / pay-as-you-go: Google's FAQ disallows "bypassing the notebook UI to
# interact primarily via a web UI" on free-tier runtimes. See tools/colab/README.md.
#
# COMFYUI_AUTH_TOKEN is the shared secret for the token gate that sits in front of the
# remote ComfyUI. ComfyUI has no authentication of its own, so without this the tunnel
# is an open image generator on the public internet. The adapter must send it as
#     Authorization: Bearer $COMFYUI_AUTH_TOKEN
# on every request. It is ignored when RV_COMFYUI_REMOTE=false.
#
# *** Never commit a real token. This file is committed; .env is not. ***
RV_COMFYUI_REMOTE=false
COMFYUI_AUTH_TOKEN=
