{
  "name": "@rv/style-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StyleBible presets, derivation from reference images, the guided wizard, probe sheets and prompt compilation.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@rv/shared-kernel": "workspace:*",
    "@rv/contracts": "workspace:*",
    "@rv/core-domain": "workspace:*",
    "@rv/prompt-kit": "workspace:*",
    "@rv/providers": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
