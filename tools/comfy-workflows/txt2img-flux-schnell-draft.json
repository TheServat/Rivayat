{
  "1": {
    "class_type": "UnetLoaderGGUF",
    "_meta": {
      "title": "FLUX.1-schnell transformer, GGUF-quantised (ComfyUI-GGUF custom node)"
    },
    "inputs": {
      "unet_name": "{{unet}}"
    }
  },
  "2": {
    "class_type": "DualCLIPLoaderGGUF",
    "_meta": {
      "title": "T5-XXL + CLIP-L — the 512-token encoder pair FLUX conditions on"
    },
    "inputs": {
      "clip_name1": "{{t5}}",
      "clip_name2": "{{clip_l}}",
      "type": "flux"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "FLUX 16-channel autoencoder"
    },
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    },
    "inputs": {
      "clip": ["2", 0],
      "text": "{{prompt}}"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negative — schnell is guidance-distilled and runs at cfg 1.0, so there is no usable negative prompt"
    },
    "inputs": {
      "conditioning": ["4", 0]
    }
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Canvas — SD3-shaped latent (16 channels), not EmptyLatentImage"
    },
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": "{{batch_size}}"
    }
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {
      "title": "schnell sampler — 4 steps, cfg 1.0, euler/simple"
    },
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": 1
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    },
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "{{filename_prefix}}"
    }
  }
}
