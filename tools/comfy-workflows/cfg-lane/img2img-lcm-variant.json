{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Base checkpoint — must match the base image's checkpoint"
    },
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "2": {
    "class_type": "LoraLoader",
    "_meta": {
      "title": "LCM LoRA"
    },
    "inputs": {
      "model": ["1", 0],
      "clip": ["1", 1],
      "lora_name": "{{lora}}",
      "strength_model": "{{lora_strength}}",
      "strength_clip": "{{lora_strength}}"
    }
  },
  "3": {
    "class_type": "ModelSamplingDiscrete",
    "_meta": {
      "title": "eps sigma schedule - the LCM distillation is switched off here (see cfg-lane/README.md)"
    },
    "inputs": {
      "model": ["2", 0],
      "sampling": "eps",
      "zsnr": false
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive — base description + the variant delta"
    },
    "inputs": {
      "clip": ["2", 1],
      "text": "{{prompt}}, {{variant}}"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    },
    "inputs": {
      "clip": ["2", 1],
      "text": "{{negative}}"
    }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Base image — POST it to /upload/image first"
    },
    "inputs": {
      "image": "{{image}}"
    }
  },
  "11": {
    "class_type": "ImageScale",
    "_meta": {
      "title": "Normalise to the target latent size"
    },
    "inputs": {
      "image": ["10", 0],
      "upscale_method": "lanczos",
      "width": "{{width}}",
      "height": "{{height}}",
      "crop": "disabled"
    }
  },
  "12": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode base image to latent"
    },
    "inputs": {
      "pixels": ["11", 0],
      "vae": ["1", 2]
    }
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {
      "title": "LCM sampler — low denoise keeps the base composition"
    },
    "inputs": {
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["12", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "denoise": "{{denoise}}"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": ["7", 0],
      "vae": ["1", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    },
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "{{filename_prefix}}"
    }
  }
}
