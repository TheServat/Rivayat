{
  "name": "@rv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NestJS delivery layer: REST generated from @rv/contracts, SSE run progress, BullMQ or in-process workers, and the composition root that binds every port to an adapter.",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "development": "./src/public.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@rv/anim-engine": "workspace:*",
    "@rv/asset-engine": "workspace:*",
    "@rv/asset-registry": "workspace:*",
    "@rv/contracts": "workspace:*",
    "@rv/core-domain": "workspace:*",
    "@rv/narrative-memory": "workspace:*",
    "@rv/persistence": "workspace:*",
    "@rv/prompt-kit": "workspace:*",
    "@rv/providers": "workspace:*",
    "@rv/render-engine": "workspace:*",
    "@rv/settings": "workspace:*",
    "@rv/shared-kernel": "workspace:*",
    "@rv/story-engine": "workspace:*",
    "@rv/style-engine": "workspace:*",
    "bullmq": "6.2.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "rimraf": "catalog:",
    "supertest": "7.2.2",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
