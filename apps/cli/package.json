{
  "name": "@rv/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "rv - the headless driver. Every milestone demo in the backlog is a command here.",
  "bin": {
    "rv": "./bin/rv.mjs"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
